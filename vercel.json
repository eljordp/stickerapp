{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tssprint.com" }],
      "destination": "https://tssprint.com/:path*",
      "permanent": true
    },
    { "source": "/order", "destination": "/stickers", "permanent": true },
    { "source": "/services/mylar-packaging", "destination": "/mylar", "permanent": true },
    { "source": "/services/event-canopies", "destination": "/services/event-displays", "permanent": true },
    { "source": "/case-studies", "destination": "/projects", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/account",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/cart",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/checkout",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://web.squarecdn.com https://www.paypal.com https://www.paypalobjects.com https://www.googletagmanager.com; frame-src 'self' https://web.squarecdn.com https://*.paypal.com; connect-src 'self' https://web.squarecdn.com https://pci-connect.squareup.com https://o160250.ingest.sentry.io https://*.supabase.co wss://*.supabase.co https://*.google-analytics.com https://*.paypal.com; style-src 'self' 'unsafe-inline' https://web.squarecdn.com; font-src 'self' data: https://square-fonts-production-f.squarecdn.com https://d1g145x70srn7h.cloudfront.net; img-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.paypal.com"
        }
      ]
    },
    {
      "source": "/order-confirmation",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "rewrites": [
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/order-confirmation", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/case-studies/:slug", "destination": "/index.html" }
  ]
}
